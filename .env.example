## Docker Compose infrastructure defaults.
## Recovery runtime uses PostgreSQL/Flyway/RabbitMQ/Redis.
## Optional object-storage practice uses MinIO behind the object-storage profile.
## Flyway uses the POSTGRES_* values below for schema bootstrap.

POSTGRES_DB=cfdi_vault
POSTGRES_USER=cfdi_vault
POSTGRES_PASSWORD=cfdi_vault
POSTGRES_PORT=5432

RABBITMQ_DEFAULT_USER=cfdi_vault
RABBITMQ_DEFAULT_PASS=cfdi_vault
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

REDIS_PORT=6379

MINIO_ROOT_USER=cfdi_vault
MINIO_ROOT_PASSWORD=cfdi_vault
MINIO_BUCKET=cfdi-vault-evidence
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

DATABASE_URL=postgresql+psycopg://cfdi_vault:cfdi_vault@postgres:5432/cfdi_vault
RABBITMQ_URL=amqp://cfdi_vault:cfdi_vault@rabbitmq:5672/
REDIS_URL=redis://redis:6379/0
# Compose uses a named volume by default; set CFDI_STORAGE_MOUNT to an
# explicitly managed host path when a bind mount is required.
CFDI_STORAGE_MOUNT=sat_artifacts_data
CFDI_STORAGE_ROOT=/var/lib/cfdi-vault/storage

## Live campaign runs (ADR 0005) are deliberately absent from this file.
##
## CFDI_VAULT_LIVE_WORKER_ENABLED and CFDI_VAULT_COMMIT_REF belong ONLY to the
## host process started by hand as `cfdi-vault-campaign-run-worker`, because the
## live sequence needs the platform credential store that no container can
## reach. Leaving them unset here keeps every Compose service — and the control
## panel API — failing closed instead of contacting SAT.
##
## Optional bounded settings for that host process (defaults shown):
##   SAT_CAMPAIGN_RUN_WORKER_ENABLED=0
##   SAT_CAMPAIGN_RUN_LEASE_SECONDS=900
##   SAT_CAMPAIGN_RUN_POLL_SECONDS=5
##   SAT_CAMPAIGN_RUN_MAX_HINTS=16
